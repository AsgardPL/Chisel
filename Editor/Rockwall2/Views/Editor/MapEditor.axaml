<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Rockwall2.ViewModels.Editor"
             xmlns:monoGame="clr-namespace:AvaloniaInside.MonoGame"
             xmlns:controls="clr-namespace:Rockwall2;assembly=Rockwall2"
             xmlns:toolbar="clr-namespace:Rockwall2.Editor.Common.Toolbar"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="Rockwall2.MapEditor"
             x:DataType="vm:MapEditorViewModel">

	<UserControl.Background>
		<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
			<GradientStop Offset="0" Color="#101010"/>
			<GradientStop Offset="1" Color="#202020"/>
		</LinearGradientBrush>
	</UserControl.Background>

	<Design.DataContext>
		<vm:MapEditorViewModel/>
	</Design.DataContext>

	<UserControl.Styles>
		<Style Selector="Button.icon-btn">
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Padding" Value="4"/>
		</Style>

		<!-- Hotbar overlay container -->
		<Style Selector="Border.hotbar-overlay">
			<Setter Property="Background" Value="#e01c1c1c"/>
			<Setter Property="BorderBrush" Value="#050505"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="8,6"/>
		</Style>

		<!-- Individual hotbar slots -->
		<Style Selector="Border.hotbar-slot">
			<Setter Property="Width" Value="36"/>
			<Setter Property="Height" Value="36"/>
			<Setter Property="BorderBrush" Value="#050505"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background">
				<Setter.Value>
					<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
						<GradientStop Offset="0" Color="#404040"/>
						<GradientStop Offset="1" Color="#202020"/>
					</LinearGradientBrush>
				</Setter.Value>
			</Setter>
		</Style>
		<Style Selector="Border.hotbar-slot.active">
			<Setter Property="BorderBrush" Value="#808080"/>
			<Setter Property="Background">
				<Setter.Value>
					<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
						<GradientStop Offset="0" Color="#606060"/>
						<GradientStop Offset="1" Color="#383838"/>
					</LinearGradientBrush>
				</Setter.Value>
			</Setter>
		</Style>
		<Style Selector="Border.hotbar-slot.empty">
			<Setter Property="Opacity" Value="0.25"/>
		</Style>

		<!-- Small label under each slot showing its number -->
		<Style Selector="TextBlock.hotbar-slot-index">
			<Setter Property="FontSize" Value="8"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="#888888"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
	</UserControl.Styles>

	<UserControl.Resources>
		<toolbar:ToolButtonTemplateSelector x:Key="ToolButtonTemplate"/>
	</UserControl.Resources>

	<Panel>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="48"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="24"/>
			</Grid.RowDefinitions>

			<Border Grid.Row="0" Padding="0" Background="Transparent" BorderBrush="#333333" BorderThickness="0,0,0,1">
				<ItemsControl x:Name="TopToolbar" Padding="0" Margin="8">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" Spacing="2"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="toolbar:ToolCategory">
							<StackPanel Orientation="Horizontal" Spacing="2">
								<ItemsControl ItemsSource="{Binding Buttons}" ItemTemplate="{StaticResource ToolButtonTemplate}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel Margin="0,0,12,0"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
								</ItemsControl>
								<Separator/>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Border>

			<!-- Sidebar / viewport / texture panel -->
			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="84"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="160"/>
				</Grid.ColumnDefinitions>

				<Border Grid.Column="0" Background="Transparent" BorderBrush="#333333" BorderThickness="0,0,1,0">
					<ItemsControl x:Name="LeftToolbar" Margin="4,8" HorizontalAlignment="Center">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Vertical" Spacing="10" HorizontalAlignment="Center"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="toolbar:ToolCategory">
								<Border Classes="toolbox-group">
									<DockPanel>
										<Border DockPanel.Dock="Top" Classes="toolbox-group-header">
											<TextBlock Text="{Binding Title}" Classes="toolbox-group-header-text"/>
										</Border>
										<ItemsControl Margin="4" ItemsSource="{Binding Buttons}" ItemTemplate="{StaticResource ToolButtonTemplate}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<WrapPanel />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
										</ItemsControl>
									</DockPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Border>

				<Panel Grid.Column="1">
					<monoGame:MonoGameControl Scene="{Binding Scene}" x:Name="gameControl"/>
				</Panel>

				<Panel Grid.Column="2">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch" x:Name="RightPanelHost">
						<Border x:Name="RightPanelContent" Background="Transparent" BorderBrush="#444444" BorderThickness="1,0,0,0" ClipToBounds="True">
							<ScrollViewer Width="160" VerticalAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
								<StackPanel Margin="10,10" Spacing="4">
									<TextBlock Text="Selected texture" FontSize="10" Foreground="#666666"/>
									<Border Height="100" Width="100" Background="#2a2a2a" BorderBrush="#333333" BorderThickness="1" CornerRadius="3">
										<Image x:Name="TexturePreview" Stretch="Uniform"/>
									</Border>
									<Button Content="Browse..." HorizontalAlignment="Stretch" Click="BrowseTextures_Click"/>

									<Label Margin="0,65,0,0" FontSize="11">Primitive Resolution</Label>
									<NumericUpDown ParsingNumberStyle="Integer" FormatString="N0" Value="12" ValueChanged="ChangePrimitiveRes"></NumericUpDown>
									<!--
									<TextBlock Text="Visgroups" Margin="0,65,0,0"
											   FontSize="10" FontWeight="SemiBold"
											   Background="#252525" Padding="4,2"/>
									<ScrollViewer Height="140" Background="#0F0F0F">
										<TreeView Padding="2">
											<TreeViewItem Header="Entities">
											</TreeViewItem>
											<TreeViewItem Header="World">
											</TreeViewItem>
											<TreeViewItem Header="User">
											</TreeViewItem>
										</TreeView>
									</ScrollViewer>
									-->
								</StackPanel>
							</ScrollViewer>
						</Border>
					</StackPanel>
				</Panel>
			</Grid>

			<StackPanel Grid.Row="2" Margin="64,0" Orientation="Horizontal" HorizontalAlignment="Right">
				<Label>Grid Size:</Label>
				<Label x:Name="gridSizeLabel">0</Label>
			</StackPanel>
		</Grid>
		
		<Border x:Name="HotbarOverlay"
				Classes="hotbar-overlay"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				Margin="0,36,0,0"
				Opacity="0"
				IsHitTestVisible="False">
			<Border.Transitions>
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
				</Transitions>
			</Border.Transitions>
			<StackPanel x:Name="HotbarItems" Orientation="Horizontal" Spacing="4"/>
		</Border>
	</Panel>
</UserControl>
